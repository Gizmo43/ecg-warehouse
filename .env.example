# Copy to .env. ecg-warehouse loads it from the working directory; variables already set in the environment win.

# S3 credentials for the signals store and the S3 dataset store.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OAuth client credentials (<client id>:<client secret>) for a REST catalog whose config has no `credential`.
ICEBERG_CATALOG_CREDENTIAL=${AWS_ACCESS_KEY_ID}:${AWS_SECRET_ACCESS_KEY}
